# ─────────────────────────────────────────────────────────────────────────────
# Non-secret Compose variables — copy to /opt/nomaos/.env
#
#   sudo install -m 0644 -o root -g root env.example /opt/nomaos/.env
#
# Compose reads this file automatically for ${...} interpolation inside
# docker-compose.yml. It must contain NO secrets: those live in .env.api, which
# render-secrets-from-vault.sh writes with mode 0600.
# ─────────────────────────────────────────────────────────────────────────────

# ── ECR ──────────────────────────────────────────────────────────────────────
AWS_REGION=eu-west-1
ECR_REGISTRY=123456789012.dkr.ecr.eu-west-1.amazonaws.com
ECR_REPOSITORY=nomaos-onboarding-api
# Immutable in prod: sha-<short_sha>. deploy.sh overrides this per release and
# rewrites the file, keeping the previous value in PREVIOUS_IMAGE_TAG.
IMAGE_TAG=latest
GIT_SHA=unknown

# ── Runtime ──────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Production
TZ=Africa/Lagos
COMPOSE_SERVICE_NAME=nomaos-api

# ── Networking ───────────────────────────────────────────────────────────────
# 127.0.0.1 keeps the container off the public interface; the host's nginx (or
# an ALB target pointing at the private IP) fronts it. Use 0.0.0.0 only when
# the security group is the only thing in front, e.g. a private dev box.
API_BIND=127.0.0.1
API_HOST_PORT=8080

# ── Health gating (used by deploy.sh) ────────────────────────────────────────
HEALTHCHECK_START_PERIOD=45s
STOP_GRACE_PERIOD=30s
HEALTH_TIMEOUT=180

# ── Resources ────────────────────────────────────────────────────────────────
API_MEM_LIMIT=1500m
API_MEM_RESERVATION=512m
API_CPU_LIMIT=2.0

# ── Vault (AppRole) — consumed by render-secrets-from-vault.sh ───────────────
# The secret id is the only sensitive value; keep it in
# /opt/nomaos/vault-approle (0600) or fetch it from SSM/instance metadata.
VAULT_ADDR=https://vault.agrovesto.com
VAULT_KV_MOUNT=kv
VAULT_SECRET_PATH=nomaos/prod/appsettings
VAULT_APPROLE_FILE=/opt/nomaos/vault-approle
