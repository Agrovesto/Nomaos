// ─────────────────────────────────────────────────────────────────────────────
// Grafana Alloy — EC2 host agent for the NomaOS Onboarding API
//
// Two supported patterns; this file works for both:
//
//   A) Host-level Alloy (preferred when the box runs more than one service):
//      install Alloy via the package repo, drop this file at
//      /etc/alloy/config.alloy, systemctl enable --now alloy.
//
//   B) Sidecar container: docker compose --profile alloy up -d
//      (mounted read-only at /etc/alloy/config.alloy).
//
// Signal flow:
//   app --OTLP--> alloy :4317/:4318 --> Tempo (traces) / Prometheus (metrics)
//   docker json-file logs ---------> alloy --> Loki
//
// Replace the *_ENDPOINT constants below with your backend addresses.
// ─────────────────────────────────────────────────────────────────────────────

logging {
  level  = "info"
  format = "json"
}

// ── OTLP intake ──────────────────────────────────────────────────────────────
otelcol.receiver.otlp "default" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

// Attach EC2 identity (instance id, AZ, region) to everything that passes
// through, so a noisy instance can be found without grepping.
otelcol.processor.resourcedetection "default" {
  detectors = ["env", "ec2"]

  output {
    traces  = [otelcol.processor.batch.default.input]
    metrics = [otelcol.processor.batch.default.input]
    logs    = [otelcol.processor.batch.default.input]
  }
}

otelcol.processor.batch "default" {
  timeout             = "5s"
  send_batch_size     = 512
  send_batch_max_size = 1024

  output {
    traces  = [otelcol.exporter.otlp.tempo.input]
    metrics = [otelcol.exporter.prometheus.default.input]
    logs    = [otelcol.exporter.loki.default.input]
  }
}

// ── Traces -> Tempo ──────────────────────────────────────────────────────────
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo.monitoring.internal:4317"
    tls { insecure = true } // private VPC link; front with mTLS if it leaves the VPC
  }
}

// ── Metrics -> Prometheus (remote write) ─────────────────────────────────────
otelcol.exporter.prometheus "default" {
  forward_to = [prometheus.remote_write.default.receiver]
}

prometheus.remote_write "default" {
  endpoint {
    url = "http://prometheus.monitoring.internal:9090/api/v1/write"
  }
}

// ── OTLP logs -> Loki ────────────────────────────────────────────────────────
otelcol.exporter.loki "default" {
  forward_to = [loki.write.default.receiver]
}

// ── Container stdout (JSON lines) -> Loki ────────────────────────────────────
// The app writes one JSON object per line; Docker's json-file driver wraps it.
// This is the path that works even when OTLP export is disabled.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_label_com_nomaos_app"]
    regex         = ".+"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_nomaos_app"]
    target_label  = "service_name"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_nomaos_env"]
    target_label  = "deployment_environment"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_nomaos_commit"]
    target_label  = "git_sha"
  }
  rule {
    source_labels = ["__meta_docker_container_name"]
    target_label  = "container"
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  labels     = { job = "nomaos/docker" }
  relabel_rules = discovery.relabel.containers.rules
  forward_to = [loki.process.nomaos.receiver]
}

// Parse the application's JSON line so trace_id becomes a real label/field and
// Grafana's Loki -> Tempo derived field can link straight to the trace.
loki.process "nomaos" {
  stage.json {
    expressions = {
      level     = "Level",
      message   = "RenderedMessage",
      trace_id  = "Properties.trace_id",
      span_id   = "Properties.span_id",
      service   = "Properties[\"service.name\"]",
    }
  }

  stage.labels {
    values = { level = "", service = "" }
  }

  // trace_id stays a structured-metadata field, not a label: it is
  // high-cardinality and would blow up the Loki index.
  stage.structured_metadata {
    values = { trace_id = "", span_id = "" }
  }

  forward_to = [loki.write.default.receiver]
}

loki.write "default" {
  endpoint {
    url = "http://loki.monitoring.internal:3100/loki/api/v1/push"
  }
}
