# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry environment block — copy to /opt/nomaos/.env.otel
#
#   sudo install -m 0644 -o root -g root env.otel.example /opt/nomaos/.env.otel
#
# NOT secret: no credentials belong in here. Everything the SDK needs is a
# standard OTEL_* variable, which is why there is no exporter URL anywhere in
# appsettings*.json.
#
# The app reads these through IConfiguration (Agrovesto.Backend.API/Observability).
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────────────
OTEL_SERVICE_NAME=nomaos-onboarding-api
OTEL_SERVICE_NAMESPACE=agrovesto
# Free-form resource attributes, merged on top of the ones the app always sets
# (service.*, deployment.environment, host.name, vcs.repository.ref.revision).
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=production,service.namespace=agrovesto,cloud.provider=aws,cloud.platform=aws_ec2

# ── Collector (Grafana Alloy inside the VPC) ─────────────────────────────────
# gRPC on 4317 (default here) or HTTP/protobuf on 4318:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.monitoring.internal:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#
# Leave OTEL_EXPORTER_OTLP_ENDPOINT EMPTY to disable export entirely: the app
# then skips exporter registration instead of retrying localhost:4317 forever.
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy.monitoring.internal:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_TIMEOUT=10000

# Optional per-signal overrides (uncomment if Alloy splits ports/paths):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://alloy.monitoring.internal:4317
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://alloy.monitoring.internal:4317
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://alloy.monitoring.internal:4317

# ── Propagation ──────────────────────────────────────────────────────────────
# W3C traceparent/tracestate end to end, plus baggage. The .NET SDK does not
# read this variable itself — ObservabilityExtensions.CreatePropagator does.
OTEL_PROPAGATORS=tracecontext,baggage

# ── Sampling ─────────────────────────────────────────────────────────────────
# Head sampling happens in the app; tail sampling (if any) lives in Alloy.
# 1.0 = keep everything. Drop to 0.25 before the trace bill does it for you.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0

# ── Metrics ──────────────────────────────────────────────────────────────────
OTEL_METRIC_EXPORT_INTERVAL=30000
OTEL_METRICS_EXEMPLAR_FILTER=trace_based

# ── Batching (defaults are fine; shown for tuning during incidents) ──────────
OTEL_BSP_SCHEDULE_DELAY=5000
OTEL_BSP_MAX_QUEUE_SIZE=2048
OTEL_BSP_MAX_EXPORT_BATCH_SIZE=512

# ── Escape hatch ─────────────────────────────────────────────────────────────
# OTEL_SDK_DISABLED=true turns off all instrumentation without a redeploy
# (compose up -d --force-recreate api is still needed to re-read env).
OTEL_SDK_DISABLED=false

# ── Application logging (read by NomaosSerilog, not by the OTel SDK) ─────────
LOG_LEVEL=Information
# Empty = stdout only, which is what Alloy scrapes. Set a path to also write a
# rolling JSON file into the bind-mounted /app/logs.
LOG_FILE_PATH=
# CloudWatch shipping. Off by default now that Loki receives the same lines.
AWS_LOGS_ENABLED=false
AWS_LOG_GROUP=/nomaos/prod/api
