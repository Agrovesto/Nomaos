# ─────────────────────────────────────────────────────────────────────────────
# NomaOS infrastructure env — copy to ${NOMAOS_STATE_DIR}/env/infra.env
#
#   docker compose -p nomaos-infra --env-file /opt/nomaos/env/infra.env \
#     -f docker-compose.infra.yml up -d
#
# HOLDS SECRETS. chmod 600, root-owned.
# ─────────────────────────────────────────────────────────────────────────────

NOMAOS_STATE_DIR=/opt/nomaos
TZ=Africa/Lagos

# ── nginx ────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# Host header nginx matches for each app. Use "_" to catch everything while
# you are still testing; set the real hostname before going live.
NOMAOS_API_SERVER_NAME=noma-api.nomaos.com
NOMAOS_APP2_SERVER_NAME=app2.invalid
# Bulk farmer uploads and image posts are large.
NOMAOS_CLIENT_MAX_BODY_SIZE=50m
# Reports and exports can run long.
NOMAOS_PROXY_READ_TIMEOUT=300s

# ── SQL Server ───────────────────────────────────────────────────────────────
# Must satisfy SQL Server's policy: 8+ chars, 3 of {upper, lower, digit, symbol}.
MSSQL_SA_PASSWORD=CHANGE_ME_STRONG_PASSWORD
# Developer is free but NOT licensed for production. Use Standard/Enterprise
# (bring your own licence) or Express (10GB cap) for real workloads.
MSSQL_PID=Developer
# Keep the engine's own cap below the container limit so the OOM killer never
# beats SQL Server's memory manager to the punch.
MSSQL_MEMORY_LIMIT_MB=4096
MSSQL_MEM_LIMIT=6g
MSSQL_AGENT_ENABLED=true
# Published on 127.0.0.1 only — reach it via an SSH tunnel, never the VPC.
MSSQL_HOST_PORT=1433

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_MAXMEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
REDIS_MEM_LIMIT=768m
