# ─────────────────────────────────────────────────────────────────────────────
# NomaOS app slot env — copy to ${NOMAOS_STATE_DIR}/env/__APP_NAME__.env
#
#   sudo install -m 600 -o root -g root app.env.example /opt/nomaos/env/nomaos-api.env
#
# HOLDS SECRETS. chmod 600, root-owned, never committed.
# bootstrap.sh creates this for you from the template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────────────
APP_NAME=__APP_NAME__
# Port Kestrel listens on *inside* the container. Not published to the host —
# nginx reaches it over the nomaos_edge network. Both apps can use 5007.
APP_PORT=5007
# nginx upstream block name. Must match a `proxy_pass http://<name>` in the
# nginx template. Defaults to APP_NAME with dashes turned into underscores.
UPSTREAM_NAME=nomaos_api

# ── ASP.NET Core ─────────────────────────────────────────────────────────────
# Program.cs skips Vault entirely when this is "Development".
ASPNETCORE_ENVIRONMENT=Staging
TZ=Africa/Lagos

# ── Vault (AppRole) — same three variables systemd exported ──────────────────
# Program.cs -> AddVaultConfiguration(kv, "nomaos/prod/appsettings")
VAULT_ADDR=https://vault.agrovesto.com
VAULT_ROLE_ID=
VAULT_SECRET_ID=

# ── Data plane ───────────────────────────────────────────────────────────────
# "localhost" no longer means the host. Use the compose service names:
#   mssql -> nomaos-mssql,  redis -> nomaos-redis
#
# Keep this in sync with whatever Vault serves at kv/nomaos/prod/appsettings —
# if Vault also supplies ConnectionStrings:DefaultConnection, Vault wins,
# because AddVaultConfiguration is registered after the env-var provider.
# QUOTE THIS. The value contains spaces and semicolons; unquoted, the shell
# that sources this file would try to run "Initial" as a command.
DB_CONNECTION_STRING="Data Source=mssql,1433;Initial Catalog=nomaosdb;User Id=sa;Password=CHANGE_ME;Encrypt=True;TrustServerCertificate=True"
REDIS_CONNECTION_STRING="redis:6379"

# ── Logging ──────────────────────────────────────────────────────────────────
# Serilog's file sink switches on only when this is non-empty (Program.cs).
# Bind-mounted to ${NOMAOS_STATE_DIR}/logs/<app>/<slot> on the host.
LOG_FILE_PATH=/app/logs/nomaos-.log

# ── Resources ────────────────────────────────────────────────────────────────
# Sized for a t3.large sharing the box with SQL Server. Both slots are briefly
# up at once during a deploy, so budget 2x APP_MEM_LIMIT plus MSSQL_MEM_LIMIT.
APP_MEM_LIMIT=1500m
APP_MEM_RESERVATION=512m

# Hangfire jobs and bulk uploads need time to finish on shutdown.
STOP_GRACE_PERIOD=30s
# The app opens SQL connections, runs migrations checks and warms Hangfire at
# boot, so give it room before the healthcheck starts counting failures.
HEALTHCHECK_START_PERIOD=15s

# ── Observability (OpenTelemetry / Alloy) ────────────────────────────────────
# Read by Agrovesto.Backend.API/Observability/ObservabilityOptions.FromConfiguration.
# There is deliberately NO exporter URL in appsettings.json: an unset endpoint
# means "no collector here" and the exporters are not registered at all. Left to
# the SDK default instead, every replica without a collector would retry
# http://localhost:4317 forever.
#
# Point the endpoint at whatever collector the environment actually runs. NOTE:
# deploy/compose has no Alloy/Loki/Tempo service yet, so on a fresh compose box
# you must either run a collector alongside it or leave the endpoint blank —
# blank is the safe local default, the exporters simply stay off.
OTEL_SERVICE_NAME=nomaos-onboarding-api
OTEL_SERVICE_NAMESPACE=agrovesto
OTEL_EXPORTER_OTLP_ENDPOINT=http://nomaos-alloy:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Escape hatch: true disables all instrumentation (spans/metrics/logs) without a
# redeploy of the image. Use it while a collector outage is being triaged.
OTEL_SDK_DISABLED=false
# W3C only. b3 is accepted but ignored because Alloy/Tempo here are W3C-native.
OTEL_PROPAGATORS=tracecontext,baggage
# Extra attributes merged on top of the code-provided ones (host.name etc).
OTEL_RESOURCE_ATTRIBUTES=

# ── Hangfire dashboard access ────────────────────────────────────────────────
# /hangfire shows every job with its serialised arguments (PII) and can
# retry/trigger/delete jobs, so it is not open. Two fail-closed options:
#   ROLES  - comma-separated; a request must be authenticated by this API and in
#            one of these roles. Empty = any authenticated principal (NOT anyone).
#   TOKEN  - a >=32 char secret nginx attaches (auth_basic in front of the
#            /hangfire location + proxy_set_header X-Nomaos-Dashboard-Token).
#            Needed because this API authenticates with JWT bearer only, so a
#            browser cannot become "authenticated" on its own.
HANGFIRE_DASHBOARD_ROLES=
HANGFIRE_DASHBOARD_EDGE_TOKEN=
