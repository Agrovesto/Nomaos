<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>opencover</Format>
          <Include>[Agrovesto.Backend.*]*</Include>
          <Exclude>[*.Tests]*,[*.Test]*,[*Test*]*</Exclude>
          <ExcludeByFile>
            **/Migrations/**/*.cs,
            **/obj/**/*.cs,
            **/*.Designer.cs,
            **/Program.cs,
            **/Startup.cs
          </ExcludeByFile>
          <ExcludeByAttribute>
            GeneratedCodeAttribute,
            ExcludeFromCodeCoverageAttribute,
            CompilerGeneratedAttribute,
            ObsoleteAttribute
          </ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
          <UseSourceLink>true</UseSourceLink>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>